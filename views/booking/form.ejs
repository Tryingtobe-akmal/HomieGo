
<% layout("./layout/boilerplate.ejs") %>
<body>
    <div class="row mt-3">
        <div class="col-8 offset-2" >
            <h2>Create a New Booking@<%= currUser.username %></h2>
            <br>
            <h4><%= listing.title %></h4>
            <form action="/listings/<%= listing._id %>/book" method="post" novalidate class="needs-validation"  >
                <div class="mb-3 mt-3">
                    <label class="form-label" for="checkin">Check In</label>
                    <input id="checkin" class="form-control" type="text" name="booking[checkedIn]" autocomplete="off" required>
                </div>
                <div class="mb-3">
                    <label for="checkout" class="form-label">Check Out</label>   
                    <input name="booking[checkedOut]" type="text" class="form-control" id="checkout" autocomplete="off"  required></input>
                </div>
                 <div class="mb-3">
                    <label for="guests" class="form-label">No of Guests</label>
                    <input type="number" id="guests" class="form-control" name="booking[guests]" placeholder="Enter no of Guests" required>
                </div>
                <button class="btn btn-dark add-btn mb-5 mt-5">Reserve</button>
            </form>
        </div>
    </div>
<script>
    const disabledDates = [];

    function addBookingDates(checkIn, checkOut) {

        let current = new Date(checkIn);
        const end = new Date(checkOut);

        while (current <= end) {

            disabledDates.push(
                current.toISOString().split("T")[0]
            );

            current.setDate(current.getDate() + 1);
        }
    }

    <% bookings.forEach(function(booking) { %>

        addBookingDates(
            "<%= booking.checkedIn.toISOString() %>",
            "<%= booking.checkedOut.toISOString() %>"
        );

    <% }); %>

    const unavailableDates=[...disabledDates];
    
   </script>
   <script src="https://cdn.jsdelivr.net/npm/vanillajs-datepicker@1.3.4/dist/js/datepicker-full.min.js"></script>

<script>
   const checkin = document.querySelector("#checkin");
   const checkout = document.querySelector("#checkout");

const checkinPicker = new Datepicker(checkin, {
    format: "yyyy-mm-dd",
    datesDisabled: disabledDates
});

const checkoutPicker = new Datepicker(checkout, {
    format: "yyyy-mm-dd",
    datesDisabled: disabledDates
});
</script>

   


</body>

