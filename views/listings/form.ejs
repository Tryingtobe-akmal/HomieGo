<% layout("./layout/boilerplate.ejs") %>
<body>
    <div class="row mt-3">
        <div class="col-8 offset-2" >
            <h3>Create a New Listing</h3>
            <form action="/listings" method="post" novalidate class="needs-validation" enctype="multipart/form-data"  >
                <div class="mb-3 mt-3">
                    <label class="form-label" for="title">Title</label>
                    <input id="title" class="form-control" type="text" name="listing[title]" placeholder="Add a catchy title" required>
                    <div class="valid-feedback">
                        Title looks Good!
                    </div>
                </div>
                <div class="mb-3">
                    <label for="description" class="form-label">Description</label>   
                    <textarea name="listing[description]" class="form-control" id="description"  placeholder="" required></textarea>
                    <div class="invalid-feedback">
                            Please enter a short description
                    </div>
                </div>
                 <div class="mb-3">
                    <label for="image" class="form-label">Upload Listing Image</label>
                    <input type="file" id="image" class="form-control" name="listing[image]" required>
                </div>
                <div class=" mb-3">
                    <label for="category" class="form-label">Select The categories</label>
                    <select id="category" class="form-select" aria-label="Default select example mt-3" name="listing[category]" required>
                        <option value="Trending">Trending</option>
                        <option value="Rooms">Rooms</option>
                        <option value="IconiCities">Iconic cities</option>
                        <option value="Mountains">Mountains</option>
                        <option value="Camping">Camping</option>
                        <option value="Castles">Castles</option>
                        <option value="AmazingPools">Amazing Pools</option>
                        <option value="Farms">Farms</option>
                        <option value="Arctic">Arctic</option>
                        <option value="Domes">Domes</option>
                        <option value="Island">Island</option>
                    </select>
                </div>
                <div class="row">
                    <div class="mb-3 col-md-4">   
                        <label for="price" class="form-label">Price</label>
                        <input  id="price" class="form-control" name="listing[price]" placeholder="1200" type="number"  required>
                        <div class="invalid-feedback">
                            Please enter a valid price!
                        </div>
                    </div>
                    <div class="mb-3 col-md-8 ">
                        <label for="country" class="form-label">Country</label>
                        <input type="text" id="country" class="form-control" name="listing[country]" placeholder="India" required>
                         <div class="invalid-feedback">
                             Country should be valid!
                        </div>
                    </div>
                </div>
                <div class="mb-3">
                    <label for="location" class="form-label">Location</label>
                    <input type="text" id="location" class="form-control" name="listing[location]" placeholder="Jaipur,Rajasthan" required>
                     <div class="invalid-feedback">
                            Location should be valid!
                    </div>
                </div>
                <button class="btn btn-dark add-btn mb-5 mt-5">Add</button>
            </form>
        </div>
    </div>
</body>
