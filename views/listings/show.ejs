<% layout("./layout/boilerplate.ejs") %>
<body>
  <div class="row mt-3">
    <div class="col-8 offset-2">
      <h3><%= clickedListing.title %><br></h3>
    </div>  
    <div class="card col-6 offset-2 listing-card" >
        <img src="<%= clickedListing.image %>" class="card-img-top show-img mt-3" alt="listing_image">
        <div class="card-body">
          <p class="card-text">
            <p><i>Owned By-<%= clickedListing.owner.username %></i> </p>
            <p><%= clickedListing.description %> </p>
            <p>&#8377;<%= clickedListing.price.toLocaleString("en-IN")%></p>
            <p><%= clickedListing.location %></p> 
            <p><%= clickedListing.country %> </p>
          </p>
        </div>
    </div>
      <!-- <ul>
          <li><%= clickedListing.title %></li>
          <li><%= clickedListing.description %></li>
          <li>&#8377;<%= clickedListing.price.toLocaleString("en-IN")%></li>
          <li><%= clickedListing.location %></li>
          <li></li>
      </ul> -->
      <br>
      <% if ( currUser && currUser._id.equals(clickedListing.owner._id)){%>
        <div class="btns">
          <a href="/listings/<%= clickedListing._id %>/edit" class="btn btn-dark col-1 offset-2 edit-btn" >Edit</a>
          <form action="/listings/<%= clickedListing._id %>?_method=DELETE" method="post">
            <button class="btn btn-dark offset-4 " >Delete</button>
          </form> 
        </div>
      <% } %>
      
      <div class="col-8 offset-2 mt-3">
        <hr>
        <h4>Leave a Review</h4>
        <%if(currUser){%>
        <form action="/listings/<%= clickedListing._id %>/review" method="POST" novalidate class="needs-validation">
          <!-- <div class="mt-3 mb-3">
            <label for="rating">Rating</label>
            <input type="range" min="1" max="5" id="rating" name="review[rating]" class="form-range">
          </div> -->
                      
            <fieldset class="starability-basic">
              <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
              <input type="radio" id="first-rate1" name="review[rating]" value="1" />
              <label for="first-rate1" title="Terrible">1 star</label>
              <input type="radio" id="first-rate2" name="review[rating]" value="2" />
              <label for="first-rate2" title="Not good">2 stars</label>
              <input type="radio" id="first-rate3" name="review[rating]" value="3" />
              <label for="first-rate3" title="Average">3 stars</label>
              <input type="radio" id="first-rate4" name="review[rating]" value="4" />
              <label for="first-rate4" title="Very good">4 stars</label>
              <input type="radio" id="first-rate5" name="review[rating]" value="5" />
              <label for="first-rate5" title="Amazing">5 stars</label>
            </fieldset>
          <div class="mt-3 mb-3">
            <label for="comment">Comment</label>
            <textarea name="review[comment]" id="comments" cols="30" rows="5" class="form-control" required></textarea>
             <div class="invalid-feedback">
                Please submit some comments for review!
              </div>
          </div class="mt-3 mb-3">
          <button class="btn btn-outline-dark">Submit</button>
        </form>
        <% } %>
        <hr>
        <h4>All Reviews</h4>
        <div class="row">
          <% for( let i = 0; i < clickedListing.review.length; i++ ) { %>
          <div class="card mt-3 mb-3 ms-3 col-5">
            <div class="card-body">
              <h5 class="card-title">@<%=clickedListing.review[i].author.username%></h5>
              <p class="starability-result" data-rating="<%=clickedListing.review[i].rating%>"></p>
              <p class="card-text"><%=clickedListing.review[i].comment%> </p>
              <% if(currUser){ %>
               <form action="/listings/<%= clickedListing._id %>/review/<%= clickedListing.review[i]._id %>?_method=DELETE" method="post" class="mb-3">
                <button class="btn btn-dark btn-sm">Delete</button>
              </form>
              <% } %>
            </div>
          </div>
          <% } %>
        </div>
      </div> 
  </div>     
</body>



