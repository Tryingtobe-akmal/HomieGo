<% layout("./layout/boilerplate.ejs") %>
<body>
  <div class="row mt-3">
    <div class="col-8 offset-2">
      <h3><%= clickedListing.title %><br></h3>
    </div>  
    <div class="card col-6 offset-2" >
        <img src="<%= clickedListing.image %>" class="card-img-top show-img mt-3" alt="listing_image">
        <div class="card-body">
          <p class="card-text">
            <%= clickedListing.description %> <br>
            &#8377;<%= clickedListing.price.toLocaleString("en-IN")%> <br>
            <%= clickedListing.location %> <br>
            <%= clickedListing.country %> <br>
          </p>
        </div>
    </div>
      <!-- <ul>
          <li><%= clickedListing.title %></li>
          <li><%= clickedListing.description %></li>
          <li>&#8377;<%= clickedListing.price.toLocaleString("en-IN")%></li>
          <li><%= clickedListing.location %></li>
          <li></li>
      </ul> -->
      <br>
      <div class="btns">
        <a href="/listings/<%= clickedListing._id %>/edit" class="btn btn-dark col-1 offset-2 edit-btn" >Edit</a>
        <form action="/listings/<%= clickedListing._id %>?_method=DELETE" method="post">
          <button class="btn btn-dark offset-4 " >Delete</button>
        </form> 
      </div>
      <div class="col-8 offset-2 mt-3">
        <hr>
        <h4>Leave a Review</h4>
        <form action="/listings/<%= clickedListing._id %>/reviews" method="POST" novalidate class="needs-validation">
          <div class="mt-3 mb-3">
            <label for="rating">Rating</label>
            <input type="range" min="1" max="5" id="rating" name="review[rating]" class="form-range">
          </div>
          <div class="mt-3 mb-3">
            <label for="comment">Comment</label>
            <textarea name="review[comment]" id="comments" cols="30" rows="5" class="form-control" required></textarea>
             <div class="invalid-feedback">
                Please submit some comments for review!
              </div>
          </div class="mt-3 mb-3">
          <button class="btn btn-outline-dark">Submit</button>
        </form>
      </div> 
  </div>     
</body>

