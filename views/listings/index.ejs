<% layout("./layout/boilerplate.ejs") %>
<body>
    <div id="filters">
        <a href="/listings?category=Rooms">
            <div class="filter">
                <div><i class="fa-solid fa-bed"></i></div>
                <p>Rooms</p>
            </div>
        </a>
        <a href="/listings?category=Trending">
            <div class="filter">
                <div> <i class="fa-solid fa-fire"></i></div>
                <p>Trending</p>
            </div>
        </a>
        <a href="/listings?category=Mountains">
            <div class="filter">
                <div><i class="fa-solid fa-mountain"></i></div>
                <p>Mountains</p>
            </div>
        </a>
          <a href="/listings?category=IconiCities">
            <div class="filter">
                <div><i class="fa-solid fa-mountain-city"></i></div>
                <p>Iconic cities</p>
            </div>
        </a>
        <a href="/listings?category=Camping">
            <div class="filter">
                <div><i class="fa-solid fa-tents"></i></div>
                <p>Camping</p>
            </div>
        </a>   
         <a href="/listings?category=Castles">
            <div class="filter">
                <div><i class="fa-solid fa-dungeon"></i></div>
                <p>Castles</p>
            </div>
        </a>
        <a href="/listings?category=AmazingPools">
            <div class="filter">
                <div><i class="fa-solid fa-water-ladder"></i></div>
                <p>Amzing Pools</p>
            </div>
        </a>
        <a href="/listings?category=Farms">
            <div class="filter">
                <div><i class="fa-solid fa-cow"></i></div>
                <p>Farms</p>
            </div>
        </a>
        <a href="/listings?category=Arctic">
            <div class="filter">
                <div><i class="fa-solid fa-rainbow"></i></div>
                <p>Arctic</p>
            </div>
        </a>
        <a href="/listings?category=Domes">
            <div class="filter">
                <div><i class="fa-solid fa-igloo"></i></div>
                <p>Domes</p>
            </div>
        </a>
        <a href="/listings?category=Island">
            <div class="filter">
                <div><i class="fa-solid fa-earth-oceania"></i></div>
                <p>Island</p>
            </div>
        </a>
        <div class="tax-toggle">
            <div class="form-check-reverse form-switch toggle">
            <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault" checked>
            <label class="form-check-label" for="switchCheckDefault">Display total after Taxes</label>
        </div>
        </div>
        
    </div>
<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3 ">
       <% for( let i=0; i<allListings.length; i++ ) { %>
            <div class="card listing-card" >
                <% if (currUser) { %>
                 <form action="/listings/<%= allListings[i]._id %>/wishlist" class="wishlist-form" method="post">
                    <div>
                        <% if (currUser && currUser.wishlist.includes(allListings[i]._id)) { %>
                          <button type="submit" class="wishlist-btn">&#10084;</button>
                        <%}else{%>
                            <button type="submit" class="wishlist-btn">&#128420;</button>
                        <%}%>
                    </div>
                 </form>
                <% } %>
                    <a href="/listings/<%= allListings[i]._id %>" class="listing-link">
                        <img src="<%= allListings[i].image.url %>" class="card-img-top" style="height: 20rem;" alt="...">
                            <div class="card-body">
                                <p class="card-text">
                                    <b><%= allListings[i].title %> <br></b>
                                    &#8377;<%= allListings[i].price.toLocaleString("en-IN")%>/night
                                    <i class="tax-info">&nbsp;&nbsp;+18% GST</i>
                                </p>
                            </div>
                    </a>        
            </div> 
        <%}%>
</div>
<script>
    let taxswitch=document.querySelector("#switchCheckDefault");
    let taxInfo=document.querySelectorAll(".tax-info");
     taxswitch.addEventListener("click",()=>{
        for(el of taxInfo){
        if(el.style.display != "none"){
            el.style.display ="none";
        }else{
            el.style.display = "inline";
        }
    }
    });
</script>
</body>

